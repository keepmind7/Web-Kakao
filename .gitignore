# 비밀정보와 로컬 인증: 저장소에 포함하지 않음
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*
*token*.json
*session*.json
auth.json
.device-uuid
*.cookie
cookies.txt
.aws/
.ssh/

# 개인자료·분석 원본·실행 기록·샘플·로컬 보관본
local-only/
docs/
evidence/
_workspace/
captures/
dumps/
raw-data/
preferences/
web-auth/
runtime.json
reader-diagnostic*.json
identity.key
*.pcap
*.pcapng
*.har
*.dmp
*.tmp

# 공유할 Codex 설정/역할만 선택적으로 포함
/.codex/*
!/.codex/config.toml
!/.codex/agents/
/.codex/agents/*
!/.codex/agents/*.toml

# 공유할 하네스 운영 문서만 선택적으로 포함
/.harness/*
!/.harness/OPERATING.md
!/.harness/FOLLOWUP.md
.harness/runs/**/.state.lock
_workspace/communications/*.lock

# 앱 패키지·분석 대상 실행 파일·추출 도구 결과
*.apk
*.xapk
*.ipa
*.exe
*.dmg
*.msi
*.apks
*.apkm
*.aab
*.jks
*.keystore
tools/apk_export/output/
tools/apk_export/platform-tools/
apk-manifest.json

# 다운로드 원본·압축 보관본
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.crdownload
*.partial

# 대화 데이터베이스와 백업
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.realm
*.bak

# 사진·동영상·화면 캡처: 합성 샘플도 local-only/에 보관
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.bmp
*.mp4
*.mov

# 빌드·의존성·재생성 가능한 테스트 캐시
node_modules/
dist/
build/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage/
htmlcov/
.nyc_output/
test-results/
playwright-report/
chrome-profile*/

# 에디터·OS·개인 설정·로그
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db
*.log
