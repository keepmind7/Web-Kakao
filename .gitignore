# --- 민감정보: 절대 커밋하지 않음 ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*
*token*.json
*session*.json
auth.json
.device-uuid
*.cookie
cookies.txt

# 프로젝트 설정과 에이전트 정의만 공유
/.codex/*
!/.codex/config.toml
!/.codex/agents/
/.codex/agents/*
!/.codex/agents/*.toml

# 운영 문서만 공유
/.harness/*
!/.harness/OPERATING.md
!/.harness/FOLLOWUP.md

# 실험 중 생성되는 원본 캡처·대화 데이터 (실제 대화 내용 유출 방지)
captures/
*.pcap
*.pcapng
*.har
dumps/
raw-data/
local-only/

# 분석 대상 바이너리 (라이선스·용량 문제로 저장소에 올리지 않고 버전·해시만 기록)
*.apk
*.xapk
*.ipa
*.exe
*.dmg
*.msi

# 빌드·의존성
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/

# 에디터·OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# 하네스 실행 잠금은 내용 없는 런타임 파일이며 Git에 보관하지 않음
.harness/runs/**/.state.lock
_workspace/communications/*.lock

# github에 올라가지 않았으면 하는것들
_workspace/
docs/
evidence/

# 실험 중 임시 응답 파일 (서버 응답 원문 유출 방지)
*.tmp

# 로컬 실행 상태·진단 (저장소 안에 생겨도 커밋 금지)
runtime.json
reader-diagnostic*.json
identity.key
preferences/
web-auth/

# 추출한 앱 패키지와 추출 키트 결과물 (카카오톡 APK 포함 가능)
*.apks
*.apkm
*.aab
*.jks
*.keystore
tools/apk_export/output/
tools/apk_export/platform-tools/
apk-manifest.json

# 압축 파일 (추출 결과·다운로드 원본)
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# 대화 데이터베이스·백업
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.realm
*.bak

# 대화 사진·화면 캡처 (실제 대화나 얼굴이 담길 수 있음)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.bmp
*.mp4
*.mov

# 브라우저 테스트 프로필과 다운로드 중 파일
chrome-profile*/
*.crdownload
*.partial

# Claude Code 개인 설정
.claude/settings.local.json

# 테스트 캐시
.pytest_cache/
coverage/
